PORT=5000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=retro_shop_v1
DB_USER=root
DB_PASSWORD=your_mysql_password

# Use long random strings in production, and keep the two secrets different.
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

# Resend (https://resend.com) — OTP, welcome, order emails
RESEND_API_KEY=re_your_api_key
# Until your domain is verified in Resend, use their default sender:
RESEND_FROM_EMAIL=onboarding@resend.dev
# After domain verification: noreply@yourdomain.com
RESEND_FROM_NAME=Retro Shop
CONTACT_INBOX_EMAIL=admin@retroshop.dev

# Cloudflare Turnstile secret from the Cloudflare dashboard.
TURNSTILE_SECRET_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Seeded on first boot. Admins cannot sign up, so change the password after login.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@retroshop.dev
SUPER_ADMIN_PASSWORD=Admin@12345

UPLOAD_MAX_SIZE=8388608
SHIPPING_FLAT_RATE=3.95
SHIPPING_FREE_THRESHOLD=50
